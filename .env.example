# ──────────────────────────────────────────────
# Idea-to-Video Generator — Environment Config
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your keys.

# Google Gemini API Key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# Fal.ai API Key (https://fal.ai/dashboard/keys)
FAL_KEY=your-fal-key-here

# Hugging Face Token (https://huggingface.co/settings/tokens)
HF_TOKEN=your-huggingface-token-here

# ── TTS Engine ──
# "edge" = Edge TTS (FREE, no API key needed, Microsoft neural voices)
# "elevenlabs" = ElevenLabs (PREMIUM, requires API key below)
TTS_ENGINE=edge

# Default voice for Edge TTS (free)
# Popular options: en-US-GuyNeural, en-US-JennyNeural, en-US-AriaNeural,
#   en-GB-RyanNeural, en-IN-PrabhatNeural, hi-IN-SwaraNeural
DEFAULT_EDGE_VOICE=en-US-GuyNeural

# ── Premium: ElevenLabs (optional) ──
# Only needed if TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
DEFAULT_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# ── Media Engines ──
# "slideshow" = FREE (Generates image via Pollinations and converts to video via FFmpeg)
# "fal" = PREMIUM (Hunyuan Video via Fal.ai)
VIDEO_ENGINE=slideshow

# "pollinations" = FREE (Open image generation, no key needed)
# "fal" = PREMIUM (FLUX via Fal.ai)
IMAGE_ENGINE=pollinations

# ── Optional Settings ──
# Set to "true" to use placeholder assets instead of real API calls (no internet/keys needed)
MOCK_MODE=false

# Output directory for generated videos
OUTPUT_DIR=output
